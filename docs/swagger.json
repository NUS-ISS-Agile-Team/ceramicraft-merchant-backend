{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/v1/item/list": {
            "get": {
                "description": "获取所有商品的列表信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "商品管理"
                ],
                "summary": "获取商品列表",
                "responses": {
                    "200": {
                        "description": "成功获取商品列表",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/ctl.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/types.ItemListResp"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "500": {
                        "description": "获取商品列表失败",
                        "schema": {
                            "$ref": "#/definitions/ctl.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/user/login": {
            "post": {
                "description": "商家端登录（只有一个合法帐号）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "权限管理"
                ],
                "summary": "商家端登录",
                "parameters": [
                    {
                        "description": "登录请求体",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/types.UserLoginReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "登录接口请求成功",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/ctl.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/types.UserLoginResp"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "500": {
                        "description": "登录接口请求错误",
                        "schema": {
                            "$ref": "#/definitions/ctl.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ctl.Response": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "type": "string"
                },
                "msg": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                }
            }
        },
        "types.ItemListResp": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/types.ItemResp"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "types.ItemResp": {
            "type": "object",
            "properties": {
                "category_id": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "img_path": {
                    "type": "string"
                },
                "num": {
                    "type": "integer"
                },
                "on_sale": {
                    "type": "boolean"
                },
                "price": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "types.UserLoginReq": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string"
                },
                "user_name": {
                    "type": "string"
                }
            }
        },
        "types.UserLoginResp": {
            "type": "object",
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "token": {
                    "type": "string"
                }
            }
        }
    }
}